<IfModule mod_rewrite.c>
    RewriteEngine On

    # ========================================================
    # 1. BLOCK KNOWN HEAVY BOTS & SCRAPERS (Saves Max Processes)
    # ========================================================
    RewriteCond %{HTTP_USER_AGENT} (AhrefsBot|SemrushBot|MJ12bot|DotBot|PetalBot|Bytespider|ClaudeBot|GPTBot|DataForSeoBot|Scrapy|curl|python-requests|Wget) [NC]
    RewriteRule .* - [F,L]

    # ========================================================
    # 3. YOUR ORIGINAL REWRITE TO /public/
    # ========================================================
    RewriteBase /

    # Route all API endpoints to Hostinger PHP backend
    RewriteRule ^api/?(.*)$ api/index.php?route=$1 [QSA,L]

    # Redirect Trailing Slashes If not a Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Direct access to existing files and folders
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rewrite all other URLs to index.html for SPA routing
    RewriteRule ^ index.html [L]
</IfModule>

# Block access to sensitive files (.env, .sql, etc.)
<FilesMatch "^\.env|\.sql$">
  Require all denied
</FilesMatch>

# Browser Caching Headers for High Speed & SEO
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/xml "access plus 1 day"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>