# Supabase Cloud
# Create a project at https://supabase.com, then copy these from Project Settings > API.
VITE_SUPABASE_URL=https://asqwddohpubsblhuspci.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Server-side database connection for migrations, seed scripts, or future backend work.
# Replace [YOUR-PASSWORD] with your Supabase database password in .env.local only.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.asqwddohpubsblhuspci.supabase.co:5432/postgres
SUPABASE_DB_HOST=db.asqwddohpubsblhuspci.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres

# App URL used by redirects, emails, and future admin flows.
VITE_APP_URL=http://localhost:5173

# Optional notification settings for future server/edge functions.
